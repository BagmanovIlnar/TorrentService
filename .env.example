# --- Torrent Service ---
# HTTP-порт веб-интерфейса (8080 занят qbittorrent)
TORRENT_HTTP_PORT=8280
# BitTorrent-порт (6881 занят qbittorrent)
TORRENT_BT_PORT=6882

# local | ad
AUTH_MODE=local
# только для AUTH_MODE=local: "user:pass,user2:pass2"
LOCAL_USERS=test:pass123
# для AUTH_MODE=ad: ldap://service_samba_addc:389 (см. home_server .env)
AD_URL=
AD_DOMAIN=HOME.ARPA

# openssl rand -hex 32
SECRET=

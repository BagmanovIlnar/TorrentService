# --- Torrent Service ---
# HTTP-порт веб-интерфейса (8080 занят qbittorrent)
TORRENT_HTTP_PORT=8280
# BitTorrent-порт (6881 занят qbittorrent)
TORRENT_BT_PORT=6882

# local | ad
AUTH_MODE=local
# только для AUTH_MODE=local: "user:pass,user2:pass2"
LOCAL_USERS=test:pass123
# для AUTH_MODE=ad: ldap://service_samba_addc:389 (см. home_server .env)
AD_URL=
AD_DOMAIN=HOME.ARPA

# openssl rand -hex 32
SECRET=

# --- Kerberos SSO (AUTH_MODE=ad, сборка с CARGO_FEATURES=sso) ---
# true: доменные машины входят без пароля (SPNEGO), нужен keytab (см. compose.home.yaml)
SSO_ENABLED=false
# SPN сервис-принципала, напр. HTTP/torrentsvc@HOME.ARPA (пусто = default из keytab)
SSO_SPN=

# --- Сид-лимиты (0 = без лимита) ---
# Сидировать пока ratio не достигнет значения, напр. 2.0
SEED_RATIO_LIMIT=0
# Сидировать не дольше N минут после завершения
SEED_TIME_MINUTES=0
